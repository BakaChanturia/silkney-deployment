{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCanonicalUbuntuImageParameter",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:us-east-1:*:parameter/aws/service/canonical/ubuntu/server/26.04/stable/current/amd64/hvm/ebs-gp3/ami-id"
    },
    {
      "Sid": "ReadInstanceConnectionStatus",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeInstanceInformation",
        "ssm:GetConnectionStatus"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "ConnectToChatbotInstances",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ec2:us-east-1:881490130721:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Project": "chatbot-baka"
        }
      }
    },
    {
      "Sid": "UseSshAndUiPortForwardingDocuments",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": [
        "arn:aws:ssm:us-east-1::document/AWS-StartSSHSession",
        "arn:aws:ssm:us-east-1::document/AWS-StartPortForwardingSession"
      ]
    },
    {
      "Sid": "ManageOwnSessions",
      "Effect": "Allow",
      "Action": [
        "ssmmessages:OpenDataChannel",
        "ssm:TerminateSession"
      ],
      "Resource": "arn:aws:ssm:us-east-1:881490130721:session/silknet7-*"
    }
  ]
}
